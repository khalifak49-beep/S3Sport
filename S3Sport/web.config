<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for S3Sport (ASP.NET Core 8, in-process hosting).
  Requires: ASP.NET Core 8 Hosting Bundle and the IIS "WebSocket Protocol" feature (for live scores).
  `dotnet publish` copies this file and fills in processPath/arguments when needed.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\S3Sport.dll" stdoutLogEnabled="false" stdoutLogFile=".\App_Data\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <!-- SignalR uses WebSockets; long-polling is the automatic fallback if this feature is missing. -->
      <webSocket enabled="true" />
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- 32 MB: matches the largest upload the app accepts (news gallery). -->
          <requestLimits maxAllowedContentLength="33554432" />
          <hiddenSegments>
            <add segment="App_Data" />
          </hiddenSegments>
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
