{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=S3SportDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "AutoMigrate": false
  },
  "Seed": {
    "DemoData": false
  },
  "SeedAdmin": {
    "Email": "",
    "Password": "",
    "FullName": "مدير النظام"
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore.SignalR": "Warning",
        "Microsoft.AspNetCore.Http.Connections": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "App_Data/logs/s3sport-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
