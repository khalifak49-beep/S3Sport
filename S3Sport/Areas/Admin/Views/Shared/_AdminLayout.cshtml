<!DOCTYPE html>
<html lang="ar" dir="rtl" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="theme-color" content="#0a0f1c" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="~/favicon.ico" sizes="48x48" />
    <title>@ViewData["Title"] | إدارة S3Sport</title>
    <script>
        try { var t = localStorage.getItem('s3s-theme'); if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-bs-theme', t); } catch (e) { }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-body">
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        string Active(string name) => controller == name ? "active" : "";
        var isAdmin = User.IsAdmin();
        var canContent = isAdmin || User.IsInRole(AppRoles.ContentManager);
        var canCompetitions = isAdmin || User.IsInRole(AppRoles.TournamentManager);
    }

    <aside class="admin-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="adminSidebar" aria-label="قائمة الإدارة">
        <div class="d-flex align-items-center justify-content-between p-3 border-bottom">
            <a class="brand" asp-area="Admin" asp-controller="@(isAdmin ? "Dashboard" : canCompetitions ? "Competitions" : "News")" asp-action="Index">
                <img class="brand-icon" src="~/icons/icon-192.png" width="36" height="36" alt="S3Sport" /><span>لوحة <span class="accent">الإدارة</span></span>
            </a>
            <button type="button" class="btn-close d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="إغلاق"></button>
        </div>
        <nav class="nav flex-column p-2">
            @if (isAdmin)
            {
                <a class="nav-link @Active("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-gauge-high"></i>لوحة التحكم</a>

                <div class="nav-section">الفرق واللاعبون</div>
                <a class="nav-link @Active("TeamApplications")" asp-area="Admin" asp-controller="TeamApplications" asp-action="Index">
                    <i class="fa-solid fa-file-signature"></i>طلبات تسجيل الفرق
                    <span class="badge rounded-pill text-bg-warning badge-count"><vc:pending-applications /></span>
                </a>
                <a class="nav-link @Active("Teams")" asp-area="Admin" asp-controller="Teams" asp-action="Index"><i class="fa-solid fa-shield-halved"></i>إدارة الفرق</a>
                <a class="nav-link @Active("Players")" asp-area="Admin" asp-controller="Players" asp-action="Index"><i class="fa-solid fa-person-running"></i>إدارة اللاعبين</a>
            }
            @if (canCompetitions)
            {
                <div class="nav-section">البطولات والمباريات</div>
                <a class="nav-link @Active("Competitions") @Active("Editions")" asp-area="Admin" asp-controller="Competitions" asp-action="Index"><i class="fa-solid fa-trophy"></i>البطولات</a>
                <a class="nav-link @Active("Matches")" asp-area="Admin" asp-controller="Matches" asp-action="Index"><i class="fa-solid fa-futbol"></i>المباريات</a>
                <a class="nav-link @Active("Venues")" asp-area="Admin" asp-controller="Venues" asp-action="Index"><i class="fa-solid fa-location-dot"></i>الملاعب</a>
            }
            @if (canContent)
            {
                <div class="nav-section">المحتوى</div>
                <a class="nav-link @Active("News")" asp-area="Admin" asp-controller="News" asp-action="Index"><i class="fa-regular fa-newspaper"></i>الأخبار والوسائط</a>
                @if (isAdmin)
                {
                    <a class="nav-link @Active("Sponsors")" asp-area="Admin" asp-controller="Sponsors" asp-action="Index"><i class="fa-solid fa-handshake-angle"></i>الرعاة</a>
                }
            }
            @if (isAdmin)
            {
                <div class="nav-section">الإعدادات</div>
                <a class="nav-link @Active("Regions")" asp-area="Admin" asp-controller="Regions" asp-action="Index"><i class="fa-solid fa-map-location-dot"></i>إدارة المناطق</a>
                <a class="nav-link @Active("Sports")" asp-area="Admin" asp-controller="Sports" asp-action="Index"><i class="fa-solid fa-medal"></i>الرياضات</a>
                <a class="nav-link @Active("Seasons")" asp-area="Admin" asp-controller="Seasons" asp-action="Index"><i class="fa-regular fa-calendar"></i>المواسم</a>

                <div class="nav-section">المستخدمون والأمان</div>
                <a class="nav-link @Active("Users")" asp-area="Admin" asp-controller="Users" asp-action="Index"><i class="fa-solid fa-users"></i>إدارة المستخدمين</a>
                <a class="nav-link @Active("Roles")" asp-area="Admin" asp-controller="Roles" asp-action="Index"><i class="fa-solid fa-user-shield"></i>الأدوار والصلاحيات</a>
                <a class="nav-link @Active("AuditLogs")" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index"><i class="fa-solid fa-clock-rotate-left"></i>سجل العمليات</a>
            }

            <hr class="my-2" />
            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-arrow-up-right-from-square"></i>عرض الموقع</a>
        </nav>
    </aside>

    <div class="admin-main">
        <header class="admin-topbar d-flex align-items-center gap-2 px-3 sticky-top">
            <button class="btn btn-soft btn-icon d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="القائمة">
                <i class="fa-solid fa-bars"></i>
            </button>
            <h1 class="h6 m-0 fw-semibold">@ViewData["Title"]</h1>
            <div class="ms-0 me-auto d-flex align-items-center gap-2">
                <button type="button" class="btn btn-soft btn-icon" data-theme-toggle aria-label="تبديل الوضع"><i data-theme-icon class="fa-solid fa-sun"></i></button>
                <span class="small text-muted d-none d-md-inline">@User.Identity?.Name</span>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn btn-soft btn-icon" title="تسجيل الخروج" aria-label="تسجيل الخروج"><i class="fa-solid fa-arrow-right-from-bracket"></i></button>
                </form>
            </div>
        </header>

        <main class="p-3 p-lg-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_Alerts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
