@model VenueFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "إضافة ملعب" : $"تعديل: {Model.NameAr}";
}
<div class="s3-card mx-auto" style="max-width:820px">
    <div class="s3-card-header"><h2>@ViewData["Title"]</h2></div>
    <div class="s3-card-body">
        <form asp-action="Save" method="post" novalidate>
            <input type="hidden" asp-for="Id" />
            <div class="row g-3">
                <div class="col-md-6"><label asp-for="NameAr" class="form-label"></label><input asp-for="NameAr" class="form-control" /><span asp-validation-for="NameAr" class="field-validation-error"></span></div>
                <div class="col-md-6"><label asp-for="NameEn" class="form-label"></label><input asp-for="NameEn" class="form-control ltr" /></div>
                <div class="col-md-4">
                    <label asp-for="GovernorateId" class="form-label"></label>
                    <select asp-for="GovernorateId" asp-items="Model.Governorates" class="form-select"><option value="">—</option></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="WilayatId" class="form-label"></label>
                    <select asp-for="WilayatId" class="form-select" data-cascade-parent="#GovernorateId" data-cascade-url="/Region/Wilayats?governorateId=" data-placeholder="—" data-selected="@Model.WilayatId"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="AreaId" class="form-label"></label>
                    <select asp-for="AreaId" class="form-select" data-cascade-parent="#WilayatId" data-cascade-url="/Region/Areas?wilayatId=" data-placeholder="—" data-selected="@Model.AreaId"></select>
                </div>
                <div class="col-md-8"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="Capacity" class="form-label"></label><input asp-for="Capacity" class="form-control" type="number" min="0" /><span asp-validation-for="Capacity" class="field-validation-error"></span></div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button class="btn btn-primary" type="submit">حفظ</button>
                <a class="btn btn-soft" asp-action="Index">رجوع</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
