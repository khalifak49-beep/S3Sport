@model List<VenueRow>
@{
    ViewData["Title"] = "الملاعب";
}
<div class="s3-card">
    <div class="s3-card-header">
        <form method="get" class="filter-bar flex-grow-1">
            <input type="search" name="search" value="@Context.Request.Query["search"]" class="form-control search" placeholder="بحث باسم الملعب أو الولاية..." />
            <button class="btn btn-soft" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
        </form>
        <a class="btn btn-primary" asp-action="Create"><i class="fa-solid fa-plus me-1"></i>إضافة ملعب</a>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty-state"><i class="fa-solid fa-location-dot d-block"></i><p class="mb-0">لا توجد ملاعب.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-stack table-hover table-nowrap">
                <thead><tr><th>الملعب</th><th>المنطقة</th><th>السعة</th><th>المباريات</th><th></th></tr></thead>
                <tbody>
                    @foreach (var v in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@v.NameAr</td>
                            <td>@(v.AreaText ?? "—")</td>
                            <td>@(v.Capacity?.ToString("N0") ?? "—")</td>
                            <td>@v.MatchesCount</td>
                            <td>
                                <div class="table-actions">
                                    <a class="btn btn-soft btn-sm" asp-action="Edit" asp-route-id="@v.Id" title="تعديل"><i class="fa-solid fa-pen"></i></a>
                                    <form asp-action="Delete" asp-route-id="@v.Id" method="post" data-confirm="حذف الملعب؟" data-confirm-text="@v.NameAr" data-confirm-danger>
                                        <button class="btn btn-soft btn-sm text-danger" type="submit" title="حذف"><i class="fa-regular fa-trash-can"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
