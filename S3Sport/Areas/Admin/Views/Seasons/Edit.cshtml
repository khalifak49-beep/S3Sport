@model SeasonFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "إضافة موسم" : $"تعديل موسم {Model.Name}";
}
<div class="s3-card mx-auto" style="max-width:640px">
    <div class="s3-card-header"><h2>@ViewData["Title"]</h2></div>
    <div class="s3-card-body">
        <form asp-action="Save" method="post" novalidate>
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>
            <div class="row g-3">
                <div class="col-12"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control ltr" placeholder="2026-2027" /><span asp-validation-for="Name" class="field-validation-error"></span></div>
                <div class="col-md-6"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" type="date" class="form-control" /><span asp-validation-for="StartDate" class="field-validation-error"></span></div>
                <div class="col-md-6"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" type="date" class="form-control" /><span asp-validation-for="EndDate" class="field-validation-error"></span></div>
                <div class="col-12"><div class="form-check form-switch"><input asp-for="IsCurrent" class="form-check-input" role="switch" /><label asp-for="IsCurrent" class="form-check-label"></label></div>
                    <div class="form-text">موسم واحد فقط يكون حالياً؛ تفعيله هنا يلغي الموسم الحالي السابق.</div></div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button class="btn btn-primary" type="submit">حفظ</button>
                <a class="btn btn-soft" asp-action="Index">رجوع</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
