@model RegionFormViewModel
@{
    var levelName = Model.Level switch
    {
        RegionLevel.Governorate => "محافظة",
        RegionLevel.Wilayat => "ولاية",
        RegionLevel.Area => "منطقة",
        _ => "قرية"
    };
    ViewData["Title"] = Model.Id == 0 ? $"إضافة {levelName}" : $"تعديل {levelName}";
    var hasSortOrder = Model.Level is RegionLevel.Governorate or RegionLevel.Wilayat;
}

<div class="s3-card mx-auto" style="max-width:640px">
    <div class="s3-card-header">
        <h2>@ViewData["Title"]</h2>
        @if (Model.ParentName != null) { <span class="text-muted small">تتبع: @Model.ParentName</span> }
    </div>
    <div class="s3-card-body">
        <form asp-action="Save" method="post" novalidate>
            <input type="hidden" asp-for="Level" />
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ParentId" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="NameAr" class="form-label"></label>
                    <input asp-for="NameAr" class="form-control" autofocus />
                    <span asp-validation-for="NameAr" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NameEn" class="form-label"></label>
                    <input asp-for="NameEn" class="form-control ltr" />
                    <span asp-validation-for="NameEn" class="field-validation-error"></span>
                </div>
                @if (hasSortOrder)
                {
                    <div class="col-md-6">
                        <label asp-for="SortOrder" class="form-label"></label>
                        <input asp-for="SortOrder" class="form-control" type="number" min="0" />
                        <span asp-validation-for="SortOrder" class="field-validation-error"></span>
                    </div>
                }
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" role="switch" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                    <div class="form-text">المناطق المعطّلة لا تظهر للمستخدمين عند الاختيار، وتبقى بياناتها محفوظة.</div>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">حفظ</button>
                <a class="btn btn-soft" asp-action="Index" asp-route-level="@Model.Level" asp-route-parentId="@Model.ParentId">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
