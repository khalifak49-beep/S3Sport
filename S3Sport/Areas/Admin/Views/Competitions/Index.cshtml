@model List<CompetitionListItem>
@{
    ViewData["Title"] = "البطولات";
}
<div class="s3-card">
    <div class="s3-card-header">
        <form method="get" class="filter-bar flex-grow-1">
            <input type="search" name="search" value="@ViewData["Search"]" class="form-control search" placeholder="بحث باسم البطولة..." />
            <button class="btn btn-soft" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
        </form>
        @if (User.IsAdmin())
        {
            <a class="btn btn-primary" asp-action="Create"><i class="fa-solid fa-plus me-1"></i>إضافة بطولة</a>
        }
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty-state"><i class="fa-solid fa-trophy d-block"></i><p class="mb-0">@(User.IsAdmin() ? "لا توجد بطولات بعد." : "لا توجد بطولات مسندة إليك.")</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-stack table-hover table-nowrap">
                <thead><tr><th>البطولة</th><th>النطاق</th><th>الرياضة</th><th>آخر نسخة</th><th>النسخ</th><th>الحالة</th><th></th></tr></thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><a class="d-flex align-items-center gap-2 text-reset" asp-action="Details" asp-route-id="@c.Id">@Html.EntityLogo(c.LogoPath, c.NameAr, 34)<span class="fw-semibold">@c.NameAr</span></a></td>
                            <td>@c.RegionText</td>
                            <td>@c.SportName</td>
                            <td>@(c.CurrentEditionName ?? "—") @if (c.CurrentEditionStatus is { } st) { <span class="badge text-bg-secondary ms-1">@st.GetDisplayName()</span> }</td>
                            <td>@c.EditionsCount</td>
                            <td>@if (c.IsActive) { <span class="badge text-bg-success">مفعّلة</span> } else { <span class="badge text-bg-secondary">معطّلة</span> }</td>
                            <td class="text-end"><a class="btn btn-soft btn-sm" asp-action="Details" asp-route-id="@c.Id">إدارة</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
