@model int
<a class="btn btn-soft btn-icon bell" asp-area="" asp-controller="Notifications" asp-action="Index" title="الإشعارات" aria-label="الإشعارات">
    <i class="fa-regular fa-bell"></i>
    @if (Model > 0)
    {
        <span class="count">@(Model > 99 ? "99+" : Model.ToString())</span>
    }
</a>
