@model IPagedResult
@* Keeps every current query-string value and only swaps "page". *@
@{
    string PageUrl(int page)
    {
        var query = Context.Request.Query
            .Where(q => !string.Equals(q.Key, "page", StringComparison.OrdinalIgnoreCase))
            .SelectMany(q => q.Value.Select(v => $"{Uri.EscapeDataString(q.Key)}={Uri.EscapeDataString(v ?? "")}"))
            .Append($"page={page}");
        return $"{Context.Request.Path}?{string.Join("&", query)}";
    }
    var start = Math.Max(1, Model.Page - 2);
    var end = Math.Min(Model.TotalPages, Model.Page + 2);
}
@if (Model.TotalCount > 0)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 p-3 border-top">
        <small class="text-muted">
            عرض @(((Model.Page - 1) * Model.PageSize) + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount)) من أصل @Model.TotalCount
        </small>
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="التنقل بين الصفحات">
                <ul class="pagination pagination-sm">
                    <li class="page-item @(Model.Page == 1 ? "disabled" : "")"><a class="page-link" href="@PageUrl(Model.Page - 1)" aria-label="السابق"><i class="fa-solid fa-chevron-right"></i></a></li>
                    @for (var p = start; p <= end; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@PageUrl(p)">@p</a></li>
                    }
                    <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@PageUrl(Model.Page + 1)" aria-label="التالي"><i class="fa-solid fa-chevron-left"></i></a></li>
                </ul>
            </nav>
        }
    </div>
}
