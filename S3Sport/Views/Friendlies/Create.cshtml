@model FriendlyRequestFormViewModel
@{
    ViewData["Title"] = "فريقي يبحث عن مباراة ودية";
}
<div class="s3-card mx-auto" style="max-width:760px">
    <div class="s3-card-header"><h2>@ViewData["Title"]</h2></div>
    <div class="s3-card-body">
        <p class="text-muted small">
            يظهر طلبك في صفحة «مباريات ودية» لكل الفرق. المسجّلون يرون رقمك ويتواصلون معك بالاتصال أو واتساب،
            ومسؤولو الفرق يرسلون عروضاً تصلك إشعاراتها. عند قبول عرض تُضاف المباراة لجدول الفريقين تلقائياً.
        </p>
        <form asp-action="Create" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>
            <div class="row g-3">
                @if (Model.Teams.Count > 1)
                {
                    <div class="col-12"><label asp-for="TeamId" class="form-label"></label><select asp-for="TeamId" asp-items="Model.Teams" class="form-select"></select><span asp-validation-for="TeamId" class="field-validation-error"></span></div>
                }
                else
                {
                    <input type="hidden" asp-for="TeamId" />
                    <div class="col-12"><div class="form-label mb-0">الفريق</div><div class="fw-semibold">@Model.Teams.FirstOrDefault()?.Text</div></div>
                }
                <div class="col-6"><label asp-for="PreferredDate" class="form-label"></label><input asp-for="PreferredDate" type="date" class="form-control" /><span asp-validation-for="PreferredDate" class="field-validation-error"></span></div>
                <div class="col-6"><label asp-for="PreferredTime" class="form-label"></label><input asp-for="PreferredTime" type="time" class="form-control" /></div>
                <div class="col-12">
                    <div class="form-label">@Html.DisplayNameFor(m => m.VenuePreference)</div>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var v in Enum.GetValues<FriendlyVenuePreference>())
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="VenuePreference" value="@v" id="venue-@v" />
                                <label class="form-check-label" for="venue-@v">@v.GetDisplayName()</label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="VenuePreference" class="field-validation-error"></span>
                </div>
                <div class="col-12" id="venueBox"><label asp-for="VenueId" class="form-label"></label><select asp-for="VenueId" asp-items="Model.Venues" class="form-select"><option value="">—</option></select><span asp-validation-for="VenueId" class="field-validation-error"></span></div>
                <div class="col-md-6"><label asp-for="ContactPhone" class="form-label"></label><input asp-for="ContactPhone" class="form-control" inputmode="tel" dir="ltr" placeholder="9XXXXXXX" /><span asp-validation-for="ContactPhone" class="field-validation-error"></span></div>
                <div class="col-md-6"><label asp-for="ContactName" class="form-label"></label><input asp-for="ContactName" class="form-control" /></div>
                <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="2" placeholder="مثال: نفضّل فريقاً من نفس الولاية، الملعب مضاء"></textarea><span asp-validation-for="Notes" class="field-validation-error"></span></div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button class="btn btn-primary" type="submit"><i class="fa-solid fa-bullhorn me-1"></i>نشر الطلب</button>
                <a class="btn btn-soft" asp-action="Index">رجوع</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <script>
        (() => {
            const box = document.getElementById('venueBox');
            const sync = () => box.classList.toggle('d-none', document.querySelector('input[name="VenuePreference"]:checked')?.value === 'Away');
            document.querySelectorAll('input[name="VenuePreference"]').forEach(r => r.addEventListener('change', sync));
            sync();
        })();
    </script>
}
