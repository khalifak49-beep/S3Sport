@model StandingsPageViewModel
@{
    ViewData["Title"] = "الترتيب";
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <h1 class="page-title">جداول الترتيب</h1>
        <p class="page-subtitle">@(Model.AllRegions ? "كل البطولات" : $"بطولات منطقتك ({Model.RegionName}) والبطولات الوطنية")</p>
    </div>
    @if (Model.HasRegion)
    {
        <div class="status-tabs">
            <a asp-action="Index" class="@(!Model.AllRegions ? "active" : "")">منطقتي</a>
            <a asp-action="Index" asp-route-all="true" class="@(Model.AllRegions ? "active" : "")">كل المناطق</a>
        </div>
    }
</div>
@if (Model.Blocks.Count == 0)
{
    <div class="s3-card empty-state"><i class="fa-solid fa-ranking-star d-block"></i><p class="mb-0">لا توجد جداول ترتيب بعد.</p></div>
}
@foreach (var b in Model.Blocks)
{
    <section class="mb-4">
        <a class="d-flex align-items-center gap-2 mb-2 text-reset" href="/competitions/@b.CompetitionSlug">
            @Html.EntityLogo(b.CompetitionLogo, b.CompetitionName, 30)
            <h2 class="h5 m-0 fw-semibold">@b.CompetitionName</h2>
            <span class="badge text-bg-secondary">@b.SeasonName</span>
        </a>
        @foreach (var t in b.Tables) { <div class="s3-card mb-3"><partial name="_StandingsTable" model="t" /></div> }
    </section>
}
