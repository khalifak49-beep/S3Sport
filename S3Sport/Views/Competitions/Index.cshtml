@model CompetitionDirectoryViewModel
@{
    ViewData["Title"] = "البطولات";
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <h1 class="page-title">البطولات</h1>
        <p class="page-subtitle">@(Model.AllRegions ? "كل البطولات في السلطنة" : $"بطولات منطقتك ({Model.RegionName}) والبطولات الوطنية")</p>
    </div>
    @if (Model.HasRegion)
    {
        <div class="status-tabs">
            <a asp-action="Index" class="@(!Model.AllRegions ? "active" : "")">منطقتي</a>
            <a asp-action="Index" asp-route-all="true" class="@(Model.AllRegions ? "active" : "")">كل المناطق</a>
        </div>
    }
</div>
@if (Model.Competitions.Count == 0)
{
    <div class="s3-card empty-state"><i class="fa-solid fa-trophy d-block"></i><p class="mb-0">لا توجد بطولات هنا بعد.</p></div>
}
else
{
    <div class="row g-3">
        @foreach (var c in Model.Competitions)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <a class="s3-card team-card text-reset" href="/competitions/@c.Slug">
                    @Html.EntityLogo(c.LogoPath, c.NameAr, 52)
                    <div class="min-w-0 flex-grow-1">
                        <div class="name text-truncate">@c.NameAr</div>
                        <div class="small text-muted text-truncate"><i class="fa-solid fa-location-dot me-1"></i>@c.RegionText</div>
                        <div class="small text-muted">@c.CurrentEditionName @if (c.CurrentEditionStatus is { } st) { <span class="badge text-bg-secondary ms-1">@st.GetDisplayName()</span> }</div>
                    </div>
                </a>
            </div>
        }
    </div>
}
