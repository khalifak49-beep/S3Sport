@model MatchCenterViewModel
@{
    ViewData["Title"] = "المباريات";
    var today = DateOnly.FromDateTime(DateTime.UtcNow.ToMuscat());
    string DayLabel(DateOnly d) => d == today ? "اليوم" : d == today.AddDays(-1) ? "أمس" : d == today.AddDays(1) ? "غداً" : d.ToDateTime(TimeOnly.MinValue).ToString("ddd");
    var total = Model.Groups.Sum(g => g.Matches.Count);
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="page-title">المباريات</h1>
        <p class="page-subtitle">@(Model.AllRegions ? "كل مباريات السلطنة" : $"مباريات منطقتك: {Model.RegionName}")</p>
    </div>
    @if (Model.HasRegion)
    {
        <div class="status-tabs">
            <a asp-action="Index" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" asp-route-live="@Model.LiveOnly" class="@(!Model.AllRegions ? "active" : "")">منطقتي</a>
            <a asp-action="Index" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" asp-route-live="@Model.LiveOnly" asp-route-all="true" class="@(Model.AllRegions ? "active" : "")">كل المناطق</a>
        </div>
    }
</div>

<nav class="day-strip mb-3" aria-label="اختيار اليوم">
    <a class="day-chip live-chip @(Model.LiveOnly ? "active" : "")" asp-action="Index" asp-route-live="true" asp-route-all="@Model.AllRegions">
        <span class="live-dot"></span> مباشر <span class="count">@Model.LiveCount</span>
    </a>
    @foreach (var d in Model.Days)
    {
        <a class="day-chip @(!Model.LiveOnly && d == Model.Date ? "active" : "")" asp-action="Index" asp-route-date="@d.ToString("yyyy-MM-dd")" asp-route-all="@Model.AllRegions">
            <span class="d-block small">@DayLabel(d)</span><span class="fw-semibold">@d.ToString("MM/dd")</span>
        </a>
    }
    <input type="date" class="form-control day-picker" value="@Model.Date.ToString("yyyy-MM-dd")" aria-label="تاريخ آخر"
           onchange="location.href='?date='+this.value+'@(Model.AllRegions ? "&all=true" : "")'" />
</nav>

@if (total == 0)
{
    <div class="s3-card empty-state">
        <i class="fa-regular fa-calendar-xmark d-block"></i>
        <p class="mb-3">@(Model.LiveOnly ? "لا توجد مباريات مباشرة الآن." : "لا توجد مباريات في هذا اليوم.")</p>
        @if (!Model.AllRegions)
        {
            <a class="btn btn-soft" asp-action="Index" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" asp-route-live="@Model.LiveOnly" asp-route-all="true">عرض كل المناطق</a>
        }
    </div>
}
@foreach (var g in Model.Groups)
{
    <section class="s3-card match-group mb-3">
        <header class="match-group-header">
            @if (g.Slug != null)
            {
                <a class="d-flex align-items-center gap-2 text-reset" href="/competitions/@g.Slug">@Html.EntityLogo(g.Logo, g.Name, 22)<span class="fw-semibold">@g.Name</span></a>
            }
            else
            {
                <span class="fw-semibold"><i class="fa-solid fa-handshake me-1"></i>@g.Name</span>
            }
            <span class="small text-muted">@g.Matches.Count</span>
        </header>
        @foreach (var m in g.Matches)
        {
            <partial name="_MatchCard" model="m" />
        }
    </section>
}
