@model MatchDetailsViewModel
@{
    var m = Model.Info;
    ViewData["Title"] = $"{m.HomeName} × {m.AwayName}";
    var hasLineups = Model.HomeLineup.Count + Model.AwayLineup.Count > 0;
}

<div data-match-page="@m.Id" id="matchPage">
    <script type="application/json" id="matchState">@Json.Serialize(Model.Live)</script>

    <section class="s3-card scoreboard match-hero mb-0 @(m.IsLive ? "is-live" : "")" data-live-match="@m.Id" data-status="@m.Status" data-period="@m.CurrentPeriod"
             data-period-start="@m.PeriodStartIso" data-period-duration="@m.PeriodDurationMinutes">
        <div class="scoreboard-meta">
            @if (m.CompetitionSlug != null) { <a href="/competitions/@m.CompetitionSlug">@m.CompetitionName</a> } else { <span>@(m.TournamentName ?? "مباراة ودية")</span> }
            @if (m.RoundName != null) { <span>· @m.RoundName</span> }
            @if (m.GroupName != null) { <span>· المجموعة @m.GroupName</span> }
        </div>
        <div class="scoreboard-row">
            @if (m.HomeSlug != null) { <a class="sb-team text-reset" href="/teams/@m.HomeSlug">@Html.EntityLogo(m.HomeLogo, m.HomeName, 72)<span>@m.HomeName</span></a> }
            else { <div class="sb-team">@Html.EntityLogo(m.HomeLogo, m.HomeName, 72)<span>@m.HomeName</span></div> }
            <div class="sb-score">
                @if (m.HasScore)
                {
                    <div class="sb-digits"><span data-home-score>@m.HomeScore</span> - <span data-away-score>@m.AwayScore</span></div>
                }
                else
                {
                    <div class="sb-kickoff"><span data-home-score></span><span>@m.KickoffAt.ToMuscatString("HH:mm")</span><span data-away-score></span></div>
                }
                <div class="sb-pens d-none" data-pens></div>
                <div class="sb-status"><span data-status>@m.Status.GetDisplayName()</span> <span class="sb-minute d-none" data-minute></span></div>
                @if (!m.HasScore) { <div class="small text-muted mt-1">@m.KickoffAt.ToMuscatString("dddd yyyy/MM/dd")</div> }
            </div>
            @if (m.AwaySlug != null) { <a class="sb-team text-reset" href="/teams/@m.AwaySlug">@Html.EntityLogo(m.AwayLogo, m.AwayName, 72)<span>@m.AwayName</span></a> }
            else { <div class="sb-team">@Html.EntityLogo(m.AwayLogo, m.AwayName, 72)<span>@m.AwayName</span></div> }
        </div>
        <div class="d-flex justify-content-center gap-2 flex-wrap pb-3">
            <partial name="_FollowButton" model="Model.Follow" />
            <button type="button" class="btn btn-soft btn-icon" data-sound-toggle aria-pressed="true" title="أصوات المباراة"><i class="fa-solid fa-volume-high"></i></button>
            @if (Model.CanOperate)
            {
                <a class="btn btn-soft" asp-controller="MatchControl" asp-action="Index" asp-route-id="@m.Id"><i class="fa-solid fa-tower-broadcast me-1"></i>شاشة التسجيل</a>
            }
        </div>
        @if (!string.IsNullOrEmpty(Model.Notes) && m.Status is MatchStatus.Postponed or MatchStatus.Cancelled)
        {
            <div class="alert alert-warning m-3 mt-0">@Model.Notes</div>
        }
    </section>

    <ul class="nav match-tabs match-tabs-line mb-3" role="tablist">
        <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-events" type="button" role="tab">التفاصيل</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-lineups" type="button" role="tab">التشكيلات</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-info" type="button" role="tab">معلومات</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-h2h" type="button" role="tab">المواجهات</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-photos" type="button" role="tab">الصور@(Model.Photos.Count > 0 ? $" ({Model.Photos.Count})" : "")</button></li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="tab-events" role="tabpanel">
            <div class="s3-card">
                <ul class="list-group list-group-flush timeline" id="timeline" aria-live="polite"></ul>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-lineups" role="tabpanel">
            @if (!hasLineups)
            {
                <div class="s3-card empty-state py-4"><i class="fa-solid fa-people-group d-block"></i><p class="mb-0">لم تُنشر التشكيلة بعد.</p></div>
            }
            else
            {
                var firstSide = Model.HomeLineup.Count > 0 ? "home" : "away";
                <div class="lineup-switch" role="group" aria-label="اختر الفريق">
                    @foreach (var (side, name, logo) in new[] { ("home", m.HomeName, m.HomeLogo), ("away", m.AwayName, m.AwayLogo) })
                    {
                        <button type="button" class="@(side == firstSide ? "active" : "")" data-lineup-show="@side" aria-pressed="@(side == firstSide ? "true" : "false")">
                            @Html.EntityLogo(logo, name, 22)<span class="text-truncate">@name</span>
                        </button>
                    }
                </div>
                @foreach (var (side, name, lineup) in new[] { ("home", m.HomeName, Model.HomeLineup), ("away", m.AwayName, Model.AwayLineup) })
                {
                    <div class="@(side == firstSide ? "" : "d-none")" data-lineup-panel="@side">
                        @if (lineup.Count == 0)
                        {
                            <div class="s3-card empty-state py-4"><i class="fa-solid fa-people-group d-block"></i><p class="mb-0">لم ينشر @name تشكيلته لهذه المباراة.</p></div>
                        }
                        else
                        {
                            <partial name="_PitchLineup" model="(side, name, lineup)" />
                        }
                    </div>
                }
            }
        </div>

        <div class="tab-pane fade" id="tab-info" role="tabpanel">
            <div class="s3-card">
                <div class="s3-card-body">
                    <dl class="info-list">
                        <dt>الموعد</dt><dd>@m.KickoffAt.ToMuscatString("dddd yyyy/MM/dd — HH:mm")</dd>
                        @if (m.CompetitionName != null) { <dt>البطولة</dt><dd><a href="/competitions/@m.CompetitionSlug">@m.CompetitionName</a>@(Model.StageName != null ? " · " + Model.StageName : "")</dd> }
                        else { <dt>النوع</dt><dd>@(m.TournamentName != null ? "بطولة: " + m.TournamentName : "مباراة ودية")</dd> }
                        <dt>الملعب</dt><dd>@(m.VenueName ?? "—") @if (Model.VenueAddress != null) { <span class="text-muted small">(@Model.VenueAddress)</span> }</dd>
                        @foreach (var (role, name) in Model.Officials) { <dt>@role.GetDisplayName()</dt><dd>@name</dd> }
                        @if (Model.Attendance != null) { <dt>الحضور</dt><dd>@Model.Attendance.Value.ToString("N0")</dd> }
                        @if (Model.BestPlayerName != null) { <dt>أفضل لاعب</dt><dd><i class="fa-solid fa-star text-warning me-1"></i><a href="/players/@Model.BestPlayerId">@Model.BestPlayerName</a></dd> }
                    </dl>
                    @if (!string.IsNullOrEmpty(Model.Summary))
                    {
                        <hr /><div style="white-space:pre-line">@Model.Summary</div>
                    }
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-h2h" role="tabpanel">
            @if (Model.HeadToHead.Count == 0)
            {
                <div class="s3-card empty-state py-4"><i class="fa-solid fa-scale-balanced d-block"></i><p class="mb-0">لا توجد مواجهات سابقة مسجلة بين الفريقين.</p></div>
            }
            else
            {
                <div class="s3-card mb-3">
                    <div class="h2h-summary">
                        <div><div class="h2h-value">@Model.HeadToHeadSummary.HomeWins</div><div class="small text-muted">فوز @m.HomeName</div></div>
                        <div><div class="h2h-value">@Model.HeadToHeadSummary.Draws</div><div class="small text-muted">تعادل</div></div>
                        <div><div class="h2h-value">@Model.HeadToHeadSummary.AwayWins</div><div class="small text-muted">فوز @m.AwayName</div></div>
                    </div>
                </div>
                <div class="s3-card match-group">
                    @{ ViewData["ShowCompetition"] = true; }
                    @foreach (var h in Model.HeadToHead) { <partial name="_MatchCard" model="h" /> }
                </div>
            }
        </div>

        <div class="tab-pane fade" id="tab-photos" role="tabpanel">
            @if (Model.PhotoUploadTeams.Count > 0)
            {
                <form class="s3-card s3-card-body mb-3 photo-upload" data-photo-upload="@m.Id" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="fw-semibold mb-2"><i class="fa-solid fa-camera me-1 text-success"></i>أضف صور المباراة</div>
                    <div class="row g-2 align-items-end">
                        @if (Model.PhotoUploadTeams.Count > 1)
                        {
                            <div class="col-sm-4">
                                <label class="form-label small">باسم فريق</label>
                                <select name="teamId" class="form-select">
                                    @foreach (var t in Model.PhotoUploadTeams) { <option value="@t.Id">@t.Name</option> }
                                </select>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" name="teamId" value="@Model.PhotoUploadTeams[0].Id" />
                        }
                        <div class="col-sm"><label class="form-label small">وصف قصير (اختياري)</label><input name="caption" class="form-control" maxlength="150" placeholder="مثال: لحظة الهدف الأول" /></div>
                        <div class="col-sm-auto">
                            <label class="btn btn-primary w-100 mb-0"><i class="fa-solid fa-images me-1"></i>اختر الصور<input type="file" accept="image/*" multiple class="d-none" data-photo-input /></label>
                        </div>
                    </div>
                    <div class="small text-muted mt-2" data-photo-status>حتى @S3Sport.Controllers.MatchPhotosController.MaxPerTeam صورة لكل فريق في المباراة. تُصغَّر الصور تلقائياً قبل الرفع.</div>
                </form>
            }
            @if (Model.Photos.Count == 0)
            {
                <div class="s3-card empty-state py-4"><i class="fa-regular fa-images d-block"></i><p class="mb-0">لا توجد صور لهذه المباراة بعد.</p></div>
            }
            else
            {
                var manageable = Model.PhotoUploadTeams.Select(t => t.Id).ToHashSet();
                <div class="photo-grid">
                    @for (var i = 0; i < Model.Photos.Count; i++)
                    {
                        var p = Model.Photos[i];
                        <button type="button" class="photo-thumb" data-photo-index="@i" data-photo-id="@p.Id" data-src="@p.Path"
                                data-caption="@p.Caption" data-team="@p.TeamName" data-can-delete="@((Model.CanModeratePhotos || manageable.Contains(p.TeamId)) ? "1" : "0")"
                                aria-label="عرض الصورة @(i + 1)">
                            <img src="@p.Path" alt="@(p.Caption ?? "صورة من المباراة")" loading="lazy" />
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    <div class="mt-4"><vc:sponsors match-id="m.Id" /></div>

    <div class="modal fade photo-viewer" id="photoViewer" tabindex="-1" aria-label="صور المباراة" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="photo-viewer-bar">
                    <button type="button" class="btn btn-icon" data-bs-dismiss="modal" aria-label="إغلاق"><i class="fa-solid fa-xmark"></i></button>
                    <span class="small" data-viewer-count></span>
                    <button type="button" class="btn btn-icon text-danger d-none" data-viewer-delete aria-label="حذف الصورة"><i class="fa-regular fa-trash-can"></i></button>
                </div>
                <div class="photo-viewer-stage">
                    <button type="button" class="photo-nav photo-next" data-viewer-step="1" aria-label="التالية"><i class="fa-solid fa-chevron-left"></i></button>
                    <img alt="" data-viewer-img />
                    <button type="button" class="photo-nav photo-prev" data-viewer-step="-1" aria-label="السابقة"><i class="fa-solid fa-chevron-right"></i></button>
                </div>
                <div class="photo-viewer-caption"><div data-viewer-caption></div><div class="small opacity-75" data-viewer-team></div></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/match.js" asp-append-version="true"></script>
    <script src="~/js/match-photos.js" asp-append-version="true"></script>
}
