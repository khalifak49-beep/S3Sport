@model ChangePasswordViewModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
}
<div class="auth-wrap">
    <div class="s3-card">
        <div class="s3-card-body">
            <h1 class="h5 fw-bold mb-4">تغيير كلمة المرور</h1>
            <form asp-action="ChangePassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>
                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label"></label>
                    <input asp-for="CurrentPassword" class="form-control ltr" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control ltr" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control ltr" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">تغيير</button>
                    <a class="btn btn-soft" asp-action="Profile">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
