@model TeamMatchFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "مباراة ودية جديدة" : "تعديل المباراة";
    var statuses = new[] { MatchStatus.Scheduled, MatchStatus.Postponed, MatchStatus.Cancelled };
}
<div class="s3-card mx-auto" style="max-width:820px">
    <div class="s3-card-header"><h2>@ViewData["Title"] — @Model.TeamName</h2></div>
    <div class="s3-card-body">
        <p class="text-muted small">
            بعد الحفظ تظهر المباراة في صفحة المباريات، ويصل إشعار لمتابعي الفريقين.
            عند بدايتها افتح «التسجيل المباشر» لتسجيل البداية والأهداف والبطاقات والتبديلات ونهاية كل شوط.
        </p>
        <form asp-action="SaveMatch" method="post" novalidate>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="TeamId" />
            <input type="hidden" asp-for="RowVersion" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="OpponentTeamId" class="form-label"></label>
                    <select asp-for="OpponentTeamId" asp-items="Model.Opponents" class="form-select"><option value="">— اختر من الفرق —</option></select>
                    <span asp-validation-for="OpponentTeamId" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="OpponentGuestName" class="form-label"></label>
                    <input asp-for="OpponentGuestName" class="form-control" placeholder="مثال: فريق شباب القرية" />
                    <span asp-validation-for="OpponentGuestName" class="field-validation-error"></span>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsHome" class="form-check-input" role="switch" />
                        <label asp-for="IsHome" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-md-6"><label asp-for="KickoffLocal" class="form-label"></label><input asp-for="KickoffLocal" type="datetime-local" class="form-control" /><span asp-validation-for="KickoffLocal" class="field-validation-error"></span></div>
                <div class="col-md-6"><label asp-for="VenueId" class="form-label"></label><select asp-for="VenueId" asp-items="Model.Venues" class="form-select"><option value="">—</option></select><span asp-validation-for="VenueId" class="field-validation-error"></span></div>
                <div class="col-md-6"><label asp-for="RefereeName" class="form-label"></label><input asp-for="RefereeName" class="form-control" /></div>
                @if (Model.Id != 0)
                {
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select">
                            @foreach (var s in statuses) { <option value="@s">@s.GetDisplayName()</option> }
                        </select>
                        <span asp-validation-for="Status" class="field-validation-error"></span>
                    </div>
                }
                <div class="col-12"><label asp-for="Notes" class="form-label"></label><input asp-for="Notes" class="form-control" placeholder="سبب التأجيل أو الإلغاء مثلاً" /></div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button class="btn btn-primary" type="submit">حفظ</button>
                <a class="btn btn-soft" asp-action="Matches" asp-route-id="@Model.TeamId">رجوع</a>
            </div>
        </form>
    </div>
</div>
