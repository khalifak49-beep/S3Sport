@model MyTeamInfoViewModel
@{
    ViewData["Title"] = $"بيانات {Model.NameAr}";
}
<div class="s3-card mx-auto" style="max-width:820px">
    <div class="s3-card-header"><h2>@ViewData["Title"]</h2></div>
    <div class="s3-card-body">
        <p class="text-muted small">اسم الفريق ومنطقته تُعدَّل عن طريق إدارة المنصة.</p>
        <form asp-action="Info" method="post" enctype="multipart/form-data" novalidate>
            <input type="hidden" asp-for="TeamId" />
            <input type="hidden" asp-for="RowVersion" />
            <div class="row g-3">
                <div class="col-md-6"><label asp-for="ShortName" class="form-label"></label><input asp-for="ShortName" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="PrimaryColor" class="form-label"></label><input asp-for="PrimaryColor" type="color" class="form-control form-control-color w-100" value="@(Model.PrimaryColor ?? "#1cc683")" /></div>
                <div class="col-md-6"><label asp-for="ContactEmail" class="form-label"></label><input asp-for="ContactEmail" class="form-control ltr" /><span asp-validation-for="ContactEmail" class="field-validation-error"></span></div>
                <div class="col-md-6"><label asp-for="SocialUrl" class="form-label"></label><input asp-for="SocialUrl" class="form-control ltr" placeholder="https://" /><span asp-validation-for="SocialUrl" class="field-validation-error"></span></div>
                <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div>
                <div class="col-12">
                    <label asp-for="Logo" class="form-label"></label>
                    <div class="d-flex align-items-center gap-3">
                        <img id="logoPreview" src="@Model.LogoPath" alt="" class="entity-logo @(Model.LogoPath == null ? "d-none" : "")" style="width:64px;height:64px" />
                        <input asp-for="Logo" type="file" class="form-control" accept="@FileUploadHelper.AllowedImageExtensions" data-preview="#logoPreview" />
                    </div>
                    <span asp-validation-for="Logo" class="field-validation-error"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button class="btn btn-primary" type="submit">حفظ</button>
                <a class="btn btn-soft" asp-action="Squad" asp-route-id="@Model.TeamId">رجوع</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
