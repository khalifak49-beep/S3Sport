@model MyTeamViewModel
@{
    ViewData["Title"] = $"إدارة {Model.NameAr}";
}
<div class="s3-card mb-4">
    <div class="team-hero-body">
        @Html.EntityLogo(Model.LogoPath, Model.NameAr, 72)
        <div class="flex-grow-1">
            <h1 class="team-title">@Model.NameAr</h1>
            <div class="team-meta"><span>@Model.Squad.Count لاعب</span><span class="badge @Model.Status.BadgeClass()">@Model.Status.GetDisplayName()</span></div>
        </div>
        <div class="team-hero-actions">
            <a class="btn btn-soft" asp-controller="Teams" asp-action="Details" asp-route-slug="@Model.Slug"><i class="fa-regular fa-eye me-1"></i>صفحة الفريق</a>
            <a class="btn btn-soft" asp-action="Info" asp-route-id="@Model.TeamId"><i class="fa-solid fa-pen me-1"></i>بيانات الفريق</a>
            <a class="btn btn-soft" asp-action="Matches" asp-route-id="@Model.TeamId"><i class="fa-solid fa-futbol me-1"></i>المباريات</a>
            <a class="btn btn-primary" asp-action="AddPlayer" asp-route-id="@Model.TeamId"><i class="fa-solid fa-user-plus me-1"></i>لاعب جديد</a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="s3-card">
            <div class="s3-card-header"><h2><i class="fa-solid fa-people-group me-1"></i>قائمة اللاعبين</h2></div>
            @if (Model.Squad.Count == 0)
            {
                <div class="empty-state py-4"><i class="fa-solid fa-person-running d-block"></i><p class="mb-0">أضف لاعبي فريقك ليظهروا في صفحة الفريق وتشكيلة المباريات.</p></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-stack table-hover table-nowrap mb-0" data-stack-main="2" data-stack-hide="1">
                        <thead><tr><th>#</th><th>اللاعب</th><th>المركز</th><th>المشاركات</th><th>الأهداف</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var p in Model.Squad)
                            {
                                <tr>
                                    <td class="shirt-number">@(p.ShirtNumber?.ToString() ?? "—")</td>
                                    <td><a class="d-flex align-items-center gap-2 text-reset" asp-controller="Players" asp-action="Details" asp-route-id="@p.Id">@if (p.ShirtNumber != null) { <span class="shirt-number d-sm-none">@p.ShirtNumber</span> }@Html.EntityLogo(p.PhotoPath, p.FullNameAr, 32)<span class="fw-semibold">@p.FullNameAr</span></a></td>
                                    <td>@(p.Position ?? "—")</td>
                                    <td>@p.Appearances</td>
                                    <td>@p.Goals</td>
                                    <td>
                                        <div class="table-actions">
                                            <a class="btn btn-soft btn-sm" asp-action="EditPlayer" asp-route-id="@Model.TeamId" asp-route-playerId="@p.Id" title="تعديل"><i class="fa-solid fa-pen"></i></a>
                                            <form asp-action="ReleasePlayer" asp-route-id="@Model.TeamId" asp-route-playerId="@p.Id" method="post"
                                                  data-confirm="إنهاء ارتباط @p.FullNameAr بالفريق؟" data-confirm-text="يصبح لاعباً حراً ويبقى سجله ومشاركاته محفوظة." data-confirm-danger>
                                                <button class="btn btn-soft btn-sm text-danger" type="submit" title="إنهاء الارتباط"><i class="fa-solid fa-user-minus"></i></button>
                                            </form>
                                            @if (p.Appearances == 0 && p.Goals == 0)
                                            {
                                                <form asp-action="DeletePlayer" asp-route-id="@Model.TeamId" asp-route-playerId="@p.Id" method="post"
                                                      data-confirm="حذف @p.FullNameAr نهائياً؟" data-confirm-text="للاعب أُضيف بالخطأ وليس له أي مباريات. لا يمكن التراجع." data-confirm-danger>
                                                    <button class="btn btn-soft btn-sm text-danger" type="submit" title="حذف اللاعب"><i class="fa-solid fa-trash"></i></button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="s3-card">
            <div class="s3-card-header"><h2><i class="fa-solid fa-user-check me-1"></i>ضم لاعب حر</h2></div>
            <div class="s3-card-body">
                <form method="get" asp-action="Squad" asp-route-id="@Model.TeamId" class="d-flex gap-2 mb-3">
                    <input name="search" value="@Model.FreeAgentSearch" class="form-control" placeholder="ابحث باسم اللاعب..." minlength="2" />
                    <button class="btn btn-soft" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                </form>
                @if (!string.IsNullOrWhiteSpace(Model.FreeAgentSearch) && Model.FreeAgents.Count == 0)
                {
                    <p class="text-muted small mb-0">لا يوجد لاعبون أحرار بهذا الاسم. اللاعبون المسجلون في فرق أخرى ينتقلون عن طريق إدارة المنصة.</p>
                }
                @foreach (var p in Model.FreeAgents)
                {
                    <form asp-action="SignFreeAgent" asp-route-id="@Model.TeamId" method="post" class="d-flex align-items-center gap-2 mb-2">
                        <input type="hidden" name="playerId" value="@p.Id" />
                        @Html.EntityLogo(p.PhotoPath, p.FullNameAr, 30)
                        <span class="flex-grow-1 small">@p.FullNameAr</span>
                        <input name="shirtNumber" type="number" min="1" max="99" class="form-control form-control-sm" style="width:64px" placeholder="رقم" />
                        <button class="btn btn-soft btn-sm" type="submit">ضم</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
