@model List<TeamCardViewModel>
@{
    ViewData["Title"] = "فرقي";
}
<div class="mb-4">
    <h1 class="page-title">الفرق التي أديرها</h1>
    <p class="page-subtitle">أدر بيانات فريقك وقائمة لاعبيه.</p>
</div>
@if (Model.Count == 0)
{
    <div class="s3-card empty-state">
        <i class="fa-solid fa-shield-halved d-block"></i>
        <p class="mb-3">لا تدير أي فريق حالياً.</p>
        <a class="btn btn-primary" asp-controller="TeamApplications" asp-action="Create">سجّل فريقك</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var t in Model)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <a class="s3-card team-card text-reset" asp-action="Squad" asp-route-id="@t.Id">
                    @Html.EntityLogo(t.LogoPath, t.NameAr, 52)
                    <div class="flex-grow-1"><div class="name">@t.NameAr</div><div class="small text-muted">@t.AreaText</div></div>
                    <i class="fa-solid fa-chevron-left text-muted"></i>
                </a>
            </div>
        }
    </div>
}
