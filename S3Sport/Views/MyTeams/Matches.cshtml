@model MyTeamMatchesViewModel
@{
    ViewData["Title"] = $"مباريات {Model.NameAr}";
}
<div class="s3-card mb-4">
    <div class="team-hero-body">
        @Html.EntityLogo(Model.LogoPath, Model.NameAr, 72)
        <div class="flex-grow-1">
            <h1 class="team-title">مباريات @Model.NameAr</h1>
            <div class="team-meta"><span>أضف مباريات فريقك الودية وسجّل أحداثها مباشرة لمتابعيك.</span></div>
        </div>
        <div class="team-hero-actions">
            <a class="btn btn-soft" asp-action="Squad" asp-route-id="@Model.TeamId"><i class="fa-solid fa-people-group me-1"></i>اللاعبون</a>
            <a class="btn btn-soft" asp-controller="Friendlies" asp-action="Create" asp-route-teamId="@Model.TeamId"><i class="fa-solid fa-bullhorn me-1"></i>ابحث عن خصم</a>
            <a class="btn btn-primary" asp-action="CreateMatch" asp-route-id="@Model.TeamId"><i class="fa-solid fa-plus me-1"></i>مباراة جديدة</a>
        </div>
    </div>
</div>

@foreach (var (title, icon, list, empty) in new[]
{
    ("القادمة والجارية", "fa-regular fa-calendar", Model.Upcoming, "لا توجد مباريات قادمة. أضف مباراة ودية وسجّل أحداثها مباشرة عند بدايتها."),
    ("المنتهية", "fa-solid fa-flag-checkered", Model.Played, (string?)null)
})
{
    if (list.Count == 0 && empty == null) { continue; }
    <h2 class="section-title"><i class="@icon"></i>@title</h2>
    @if (list.Count == 0)
    {
        <div class="s3-card empty-state mb-4 py-4"><i class="fa-solid fa-futbol d-block"></i><p class="mb-0">@empty</p></div>
    }
    else
    {
        <div class="row g-3 mb-4">
            @foreach (var m in list)
            {
                var operable = Model.Operable.Contains(m.Id);
                var editable = Model.Organized.Contains(m.Id) && m.Status is MatchStatus.Scheduled or MatchStatus.Postponed or MatchStatus.Cancelled;
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="s3-card op-card p-3 h-100 d-flex flex-column"
                         data-live-match="@m.Id" data-status="@m.Status" data-period="@m.CurrentPeriod"
                         data-period-start="@m.PeriodStartIso" data-period-duration="@m.PeriodDurationMinutes">
                        <a class="text-reset d-block flex-grow-1" href="/matches/@m.Id">
                            <div class="small text-muted mb-2 d-flex justify-content-between gap-2">
                                <span class="text-truncate">@(m.CompetitionName ?? "مباراة ودية") @(m.RoundName != null ? "· " + m.RoundName : "")</span>
                                <span class="text-nowrap">@m.KickoffAt.ToMuscatString("ddd MM/dd HH:mm")</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <div class="flex-grow-1 d-flex align-items-center gap-2 min-w-0">@Html.EntityLogo(m.HomeLogo, m.HomeName, 30)<span class="text-truncate">@m.HomeName</span></div>
                                <div class="fw-bold fs-5 text-nowrap"><span data-home-score>@(m.HasScore ? m.HomeScore.ToString() : "-")</span> : <span data-away-score>@(m.HasScore ? m.AwayScore.ToString() : "-")</span></div>
                                <div class="flex-grow-1 d-flex align-items-center gap-2 justify-content-end min-w-0"><span class="text-truncate">@m.AwayName</span>@Html.EntityLogo(m.AwayLogo, m.AwayName, 30)</div>
                            </div>
                            <div class="text-center small mt-2"><span data-status>@m.Status.GetDisplayName()</span> <span class="sb-minute d-none" data-minute></span></div>
                        </a>
                        @if (operable || editable)
                        {
                            <div class="d-flex flex-wrap gap-2 mt-3 pt-3 border-top">
                                @if (operable && m.Status != MatchStatus.Cancelled)
                                {
                                    <a class="btn btn-primary btn-sm flex-grow-1" asp-controller="MatchControl" asp-action="Index" asp-route-id="@m.Id">
                                        <i class="fa-solid fa-tower-broadcast me-1"></i>@(m.Status == MatchStatus.Finished ? "الأحداث والتصحيح" : "التسجيل المباشر")
                                    </a>
                                }
                                @if (editable)
                                {
                                    <a class="btn btn-soft btn-sm" asp-action="EditMatch" asp-route-id="@Model.TeamId" asp-route-matchId="@m.Id" title="تعديل"><i class="fa-solid fa-pen me-1"></i>تعديل</a>
                                    <form asp-action="DeleteMatch" asp-route-id="@Model.TeamId" asp-route-matchId="@m.Id" method="post"
                                          data-confirm="حذف المباراة؟" data-confirm-text="@m.HomeName × @m.AwayName" data-confirm-danger>
                                        <button class="btn btn-soft btn-sm text-danger" type="submit" title="حذف"><i class="fa-solid fa-trash"></i></button>
                                    </form>
                                }
                            </div>
                        }
                        else if (m.CompetitionName != null && m.Status != MatchStatus.Finished)
                        {
                            <div class="small text-muted mt-3 pt-3 border-top">مباراة بطولة: يسجّلها مسؤول البطولة.</div>
                        }
                    </div>
                </div>
            }
        </div>
    }
}
