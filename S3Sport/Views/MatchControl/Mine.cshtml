@model OperatorMatchListViewModel
@{
    ViewData["Title"] = "مبارياتي — تسجيل الأحداث";
}
<div class="mb-4">
    <h1 class="page-title">مبارياتي</h1>
    <p class="page-subtitle">المباريات التي يمكنك تسجيل أحداثها مباشرة: المسندة إليك، ومباريات فريقك الودية.</p>
</div>

@foreach (var (title, icon, list, empty) in new[]
{
    ("مباشر الآن", "fa-tower-broadcast text-danger", Model.Live, (string?)null),
    ("القادمة", "fa-regular fa-calendar", Model.Upcoming, "لا توجد مباريات قادمة. مسؤول الفريق يضيف مباريات فريقه من «إدارة فريقي ← المباريات»."),
    ("المنتهية مؤخراً", "fa-solid fa-flag-checkered", Model.Recent, (string?)null)
})
{
    if (list.Count == 0 && empty == null) { continue; }
    <h2 class="section-title"><i class="fa-solid @icon"></i>@title</h2>
    @if (list.Count == 0)
    {
        <div class="s3-card empty-state mb-4 py-4"><p class="mb-0">@empty</p></div>
    }
    else
    {
        <div class="row g-3 mb-4">
            @foreach (var m in list)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <a class="s3-card op-card text-reset d-block p-3" asp-action="Index" asp-route-id="@m.Id"
                       data-live-match="@m.Id" data-status="@m.Status" data-period="@m.CurrentPeriod"
                       data-period-start="@(m.CurrentPeriodStartedAt is { } p ? DateTime.SpecifyKind(p, DateTimeKind.Utc).ToString("O") : "")">
                        <div class="small text-muted mb-2 d-flex justify-content-between"><span>@m.CompetitionName @(m.RoundName != null ? "· " + m.RoundName : "")</span><span>@m.KickoffAt.ToMuscatString("ddd MM/dd HH:mm")</span></div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="flex-grow-1 d-flex align-items-center gap-2 min-w-0">@Html.EntityLogo(m.HomeLogo, m.HomeName, 30)<span class="text-truncate">@m.HomeName</span></div>
                            <div class="fw-bold fs-5"><span data-home-score>@(m.Status == MatchStatus.Scheduled ? "-" : m.HomeScore.ToString())</span> : <span data-away-score>@(m.Status == MatchStatus.Scheduled ? "-" : m.AwayScore.ToString())</span></div>
                            <div class="flex-grow-1 d-flex align-items-center gap-2 justify-content-end min-w-0"><span class="text-truncate">@m.AwayName</span>@Html.EntityLogo(m.AwayLogo, m.AwayName, 30)</div>
                        </div>
                        <div class="text-center small mt-2"><span data-status>@m.Status.GetDisplayName()</span> <span class="sb-minute d-none" data-minute></span></div>
                    </a>
                </div>
            }
        </div>
    }
}
