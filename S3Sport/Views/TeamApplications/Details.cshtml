@model TeamApplicationDetailsViewModel
@{
    ViewData["Title"] = $"طلب فريق {Model.NameAr}";
    var canEdit = Model.Status is TeamStatus.Pending or TeamStatus.Rejected;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        @Html.EntityLogo(Model.LogoPath, Model.NameAr, 64)
        <div>
            <h1 class="page-title">@Model.NameAr</h1>
            <div class="text-muted ltr">@Model.NameEn</div>
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (canEdit)
        {
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">
                <i class="fa-solid fa-pen me-1"></i>@(Model.Status == TeamStatus.Rejected ? "تصحيح وإعادة التقديم" : "تعديل الطلب")
            </a>
        }
        <a class="btn btn-soft" asp-action="Index">كل طلباتي</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="s3-card">
            <div class="s3-card-header"><h2>بيانات الطلب</h2><span class="badge @Model.Status.BadgeClass()">@Model.Status.GetDisplayName()</span></div>
            <div class="s3-card-body"><partial name="_ApplicationInfo" model="Model" /></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="s3-card">
            <div class="s3-card-header"><h2>حالة المراجعة</h2></div>
            <div class="s3-card-body">
                @switch (Model.Status)
                {
                    case TeamStatus.Pending:
                        <p class="mb-0"><i class="fa-regular fa-hourglass-half text-warning me-1"></i>طلبك قيد المراجعة. سيصلك إشعار عند اتخاذ القرار.</p>
                        break;
                    case TeamStatus.Approved:
                        <p><i class="fa-solid fa-circle-check text-success me-1"></i>تمت الموافقة على الطلب وأصبح الفريق منشوراً في المنصة.</p>
                        break;
                    case TeamStatus.Rejected:
                        <p><i class="fa-solid fa-circle-xmark text-danger me-1"></i>تم رفض الطلب. يمكنك تصحيح البيانات وإعادة التقديم.</p>
                        break;
                }
                @if (Model.ReviewedAt.HasValue)
                {
                    <dl class="info-list mt-3">
                        <dt>تاريخ المراجعة</dt><dd>@Model.ReviewedAt.ToMuscatString()</dd>
                        @if (!string.IsNullOrEmpty(Model.ReviewNotes))
                        {
                            <dt>ملاحظات</dt><dd>@Model.ReviewNotes</dd>
                        }
                    </dl>
                }
            </div>
        </div>
    </div>
</div>
