@model TeamApplicationFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "تعديل طلب تسجيل فريق" : "تسجيل فريق جديد";
}
<div class="mb-4">
    <h1 class="page-title">@ViewData["Title"]</h1>
    <p class="page-subtitle">يراجع فريق المنصة طلبك، وبعد الموافقة يُنشر الفريق وتصبح مسؤولاً عن إدارته.</p>
</div>

@if (isEdit && !string.IsNullOrEmpty(Model.ReviewNotes))
{
    <div class="alert alert-warning"><strong>ملاحظات المراجعة:</strong> @Model.ReviewNotes</div>
}

<div class="s3-card">
    <div class="s3-card-body">
        <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : null)" method="post" enctype="multipart/form-data" novalidate>
            <input type="hidden" asp-for="RowVersion" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>

            <partial name="_TeamFormFields" model="Model" />

            <div class="row g-3 mt-0">
                <div class="col-md-6">
                    <label asp-for="ContactPhone" class="form-label"></label>
                    <input asp-for="ContactPhone" class="form-control ltr" placeholder="9XXXXXXX" />
                    <span asp-validation-for="ContactPhone" class="field-validation-error"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-paper-plane me-1"></i>@(isEdit ? "حفظ وإرسال للمراجعة" : "إرسال الطلب")</button>
                <a class="btn btn-soft" asp-action="Index">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
