@model IList<TeamApplicationListItem>
@{
    ViewData["Title"] = "طلبات تسجيل الفرق";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="page-title">طلبات تسجيل الفرق</h1>
        <p class="page-subtitle">تابع حالة طلباتك. بعد الموافقة يصبح الفريق منشوراً وتصبح مسؤولاً عنه.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="fa-solid fa-plus me-1"></i>طلب جديد</a>
</div>

@if (User.IsInRole(AppRoles.SuperAdmin) || User.IsInRole(AppRoles.Admin))
{
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2">
        <i class="fa-solid fa-circle-info"></i>
        <span class="flex-grow-1">هذه صفحة الطلبات التي قدمتها أنت. لمراجعة طلبات المستخدمين واعتمادها انتقل إلى لوحة الإدارة.</span>
        <a class="btn btn-sm btn-primary" asp-area="Admin" asp-controller="TeamApplications" asp-action="Index">مراجعة طلبات الفرق</a>
    </div>
}

@if (Model.Count == 0)
{
    <div class="s3-card empty-state">
        <i class="fa-solid fa-file-signature d-block"></i>
        <p class="mb-3">لم تقدم أي طلب بعد.</p>
        <a class="btn btn-primary" asp-action="Create">سجّل فريقك الآن</a>
    </div>
}
else
{
    <div class="s3-card">
        <div class="table-responsive">
            <table class="table table-stack table-hover table-nowrap">
                <thead><tr><th>الفريق</th><th>المنطقة</th><th>تاريخ التقديم</th><th>الحالة</th><th></th></tr></thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @Html.EntityLogo(a.LogoPath, a.NameAr, 36)
                                    <div><div class="fw-semibold">@a.NameAr</div><div class="small text-muted ltr">@a.NameEn</div></div>
                                </div>
                            </td>
                            <td>@a.RegionText</td>
                            <td class="text-nowrap">@a.SubmittedAt.ToMuscatString("yyyy/MM/dd")</td>
                            <td><span class="badge @a.Status.BadgeClass()">@a.Status.GetDisplayName()</span></td>
                            <td class="text-end"><a class="btn btn-soft btn-sm" asp-action="Details" asp-route-id="@a.Id">التفاصيل</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
